{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cot-quant-dashboard",
  "main": "artifacts/api-server/cloudflare/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./artifacts/cot-quant-dashboard/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cot-quant-data",
    "database_id": "a882cbc3-97c4-49e0-a611-3c9facc88d88",
    "migrations_dir": "deployment/cloudflare/migrations"
  }],
  "vars": {
    "GITHUB_REPOSITORY": "HotepMF/cot-quant-dashboard",
    "CFTC_WORKFLOW_REF": "main"
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
